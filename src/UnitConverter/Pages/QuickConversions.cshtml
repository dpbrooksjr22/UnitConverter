    </div>

    <button type="submit" class="btn btn-primary">Convert</button>
</form>

<hr />

<h2>Meters to Feet</h2>

<form method="get" asp-page-handler="@ConversionTypes.MetersToFeet">
    <div class="mb-3">
        <input type="hidden" name="handler" value="@ConversionTypes.MetersToFeet" />
        <label for="meters" class="form-label">Meters</label>

        <input id="meters"
